    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import csv\n",
        "\n",
        "MAX_ELEMENT = 200\n",
        "\n",
        "\n",
        "# HeapNode  (HeapNode.h \ub300\uc751)\n",
        "class HeapNode:\n",
        "    def __init__(self, key=0, name=\"\", birthday=\"\"):\n",
        "        self.key      = key\n",
        "        self.name     = name\n",
        "        self.birthday = birthday\n",
        "\n",
        "    def setKey(self, key):\n",
        "        self.key = key\n",
        "\n",
        "    def getKey(self):\n",
        "        return self.key\n",
        "\n",
        "    def display(self):\n",
        "        print(f\"{self.key:8d}\", end=\"\")\n",
        "\n",
        "\n",
        "# MaxHeap  (MaxHeap.h \ub300\uc751)\n",
        "class MaxHeap:\n",
        "    def __init__(self):\n",
        "        self.size = 0\n",
        "        self.node = [HeapNode() for _ in range(MAX_ELEMENT)]  # 1-indexed\n",
        "\n",
        "    def isEmpty(self):\n",
        "        return self.size == 0\n",
        "\n",
        "    def isFull(self):\n",
        "        return self.size == MAX_ELEMENT - 1\n",
        "\n",
        "    def getParent(self, i):\n",
        "        return self.node[i // 2]\n",
        "\n",
        "    def getLeft(self, i):\n",
        "        return self.node[i * 2]\n",
        "\n",
        "    def getRight(self, i):\n",
        "        return self.node[i * 2 + 1]\n",
        "\n",
        "    def _copy_node(self, src):\n",
        "        return HeapNode(src.key, src.name, src.birthday)\n",
        "\n",
        "    def insert(self, key, name=\"\", birthday=\"\"):\n",
        "        if self.isFull():\n",
        "            return\n",
        "        self.size += 1\n",
        "        idx = self.size\n",
        "        while idx != 1 and key > self.getParent(idx).getKey():\n",
        "            self.node[idx] = self._copy_node(self.node[idx // 2])\n",
        "            idx //= 2\n",
        "        self.node[idx] = HeapNode(key, name, birthday)\n",
        "\n",
        "    def remove(self):\n",
        "        if self.isEmpty():\n",
        "            return None\n",
        "        removed = self._copy_node(self.node[1])\n",
        "        last    = self._copy_node(self.node[self.size])\n",
        "        self.size -= 1\n",
        "\n",
        "        parent = 1\n",
        "        child  = 2\n",
        "        while child <= self.size:\n",
        "            if (child < self.size and\n",
        "                    self.getLeft(parent).getKey() < self.getRight(parent).getKey()):\n",
        "                child += 1\n",
        "            if last.getKey() >= self.node[child].getKey():\n",
        "                break\n",
        "            self.node[parent] = self._copy_node(self.node[child])\n",
        "            parent = child\n",
        "            child *= 2\n",
        "        self.node[parent] = last\n",
        "        return removed\n",
        "\n",
        "    def find(self):\n",
        "        return self.node[1]\n",
        "\n",
        "    def display(self):\n",
        "        i     = 1\n",
        "        level = 1\n",
        "        while i <= self.size:\n",
        "            if i == level:\n",
        "                print()\n",
        "                level *= 2\n",
        "            self.node[i].display()\n",
        "            i += 1\n",
        "        print(\"\\n\" + \"-\" * 36)\n",
        "\n",
        "\n",
        "# CSV \ub85c\ub529 (\uc804\uccb4 \uc778\uc6d0)\n",
        "def load_all_birthdays(filepath):\n",
        "    records = []\n",
        "    with open(filepath, encoding=\"utf-8-sig\", newline=\"\") as f:\n",
        "        reader = csv.reader(f)\n",
        "        next(reader)  # \ud5e4\ub354 \uc2a4\ud0b5\n",
        "        for row in reader:\n",
        "            if not row or row[0].strip() == \"\":\n",
        "                continue\n",
        "            name = row[0].strip()\n",
        "            try:\n",
        "                if len(row) < 4 or row[1].strip() == \"\" or row[2].strip() == \"\" or row[3].strip() == \"\":\n",
        "                    raise ValueError(\"\ube48 \uac12\")\n",
        "                year  = int(float(row[1]))\n",
        "                month = int(float(row[2]))\n",
        "                day   = int(float(row[3]))\n",
        "                key   = year * 10000 + month * 100 + day\n",
        "                bday  = f\"{year}\ub144 {month:02d}\uc6d4 {day:02d}\uc77c\"\n",
        "                records.append((key, name, bday))\n",
        "            except (ValueError, IndexError):\n",
        "                print(f\"  [\uacbd\uace0] '{name}' \uc0dd\ub144\uc6d4\uc77c \uc5c6\uc74c -> \uac74\ub108\ub700\")\n",
        "    return records\n",
        "\n",
        "\n",
        "# \uba54\uc778\n",
        "def main():\n",
        "    filepath = \"C:/Users/\uc720\uac00\ud604/Downloads/birthday.csv.csv\"\n",
        "\n",
        "    print(\"=\" * 46)\n",
        "    print(\"  MaxHeap\uc73c\ub85c \uc0dd\uc77c\uc774 \ub290\ub9b0 \uc21c\uc11c TOP 10 \ucd9c\ub825\")\n",
        "    print(\"=\" * 46)\n",
        "\n",
        "    records = load_all_birthdays(filepath)\n",
        "    if not records:\n",
        "        print(\"\ub370\uc774\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\")\n",
        "        return\n",
        "\n",
        "    heap = MaxHeap()\n",
        "    for key, name, bday in records:\n",
        "        heap.insert(key, name, bday)\n",
        "\n",
        "    print(f\"\\n  \ucd1d {heap.size}\uba85 \ud799 \uc0bd\uc785 \uc644\ub8cc\\n\")\n",
        "\n",
        "    count = min(10, heap.size)\n",
        "    print(f\"  \uc0dd\uc77c\uc774 \uac00\uc7a5 \ub2a6\uc740 {count}\uba85 (\ub290\ub9b0 \uc21c\uc11c)\")\n",
        "    print(\"  \" + \"-\" * 42)\n",
        "    for rank in range(1, count + 1):\n",
        "        node = heap.remove()\n",
        "        if node:\n",
        "            print(f\"  {rank:>2}\uc704  {node.name:<12} {node.birthday}\")\n",
        "    print(\"=\" * 46)\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ],
      "outputs": [],
      "execution_count": null
    }
